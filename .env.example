# Required to run the Telegram bot. Do not commit the real token.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=
VACANCY_AI_MAX_OUTPUT_TOKENS=1536
CV_AI_MAX_OUTPUT_TOKENS=1536
CV_AI_TIMEOUT_SECONDS=
# Optional internal users.id for the local single-user Web client (not Telegram ID).
# Optional when using real email login; only needed for transitional dev fallback.
WEB_DEV_USER_ID=
# make dev generates a separate ephemeral API/Next-only credential for this ID.
# For standalone development only; forbidden in production, never NEXT_PUBLIC_.
WEB_DEV_API_TOKEN=
# Required for standalone API/Bot; same server-only secret, at least 32 characters.
# make dev generates an ephemeral shared credential if empty; Web never receives it.
BOT_API_SERVICE_TOKEN=
# Standalone API defaults to production/enforced. Legacy is explicit loopback dev only.
APP_ENV=production
AUTH_ROLLOUT_MODE=enforced

# Trusted public Web origin (exact scheme + host + port, no trailing slash).
# Required HTTPS origin in production; make dev permits fixed local :3100 origins.
WEB_PUBLIC_ORIGIN=
