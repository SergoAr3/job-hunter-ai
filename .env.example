# Required to run the Telegram bot. Do not commit the real token.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=
VACANCY_AI_MAX_OUTPUT_TOKENS=1536
CV_AI_MAX_OUTPUT_TOKENS=1536
CV_AI_TIMEOUT_SECONDS=
# Required for standalone API/Bot; same server-only secret, at least 32 characters.
# make dev generates an ephemeral shared credential if empty; Web never receives it.
BOT_API_SERVICE_TOKEN=
# Standalone API defaults to production. User access always requires a session.
APP_ENV=production

# Trusted public Web origin (exact scheme + host + port, no trailing slash).
# Required HTTPS origin in production; make dev permits fixed local :3100 origins.
WEB_PUBLIC_ORIGIN=

# Public username of the Bot used for Telegram Web deep links (without @).
TELEGRAM_BOT_USERNAME=

# API email delivery. Production requires SMTP-over-TLS plus trusted Web origin.
AUTH_MAIL_DELIVERY=smtp
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_MAIL_FROM=
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
# Local-only capture: APP_ENV=development, AUTH_MAIL_DELIVERY=capture.
# make dev explicitly uses capture; standalone production uses SMTP.
AUTH_MAIL_SINK_DIR=
